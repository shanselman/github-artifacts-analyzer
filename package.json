    "dotenv": "^17.2.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/bytes": "^3.1.5",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  }
