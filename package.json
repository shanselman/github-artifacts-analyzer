{
  "name": "github-artifacts-analyzer",
  "version": "1.0.0",
  "description": "Analyze GitHub repository artifacts and storage usage",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "github-artifacts": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "analyze": "tsc && node dist/index.js analyze",
    "cleanup": "tsc && node dist/index.js analyze --cleanup",
    "test": "echo \"Error: no test specified\" && exit 1",
    "example": "./examples.sh",
    "lint": "echo 'Linting not configured yet'",
    "version": "tsc && node dist/index.js --version"
  },
  "keywords": [
    "github",
    "artifacts",
    "storage",
    "cli",
    "analysis"
  ],
  "author": "Scott Hanselman",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "bytes": "^3.1.2",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "dotenv": "^17.2.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.17",
    "typescript": "^5.9.2"
  }
}
