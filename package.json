{
  "name": "github-artifacts-analyzer",
  "version": "1.0.0",
  "description": "Analyze GitHub repository artifacts and storage usage",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "github-artifacts": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "analyze": "tsc && node dist/index.js analyze",
    "cleanup": "tsc && node dist/index.js analyze --cleanup",
    "test": "npm run build && node --test tests/cli.test.mjs tests/analyzer.test.mjs",
    "example": "./examples.sh",
    "lint": "echo 'Linting not configured yet'",
    "version": "tsc && node dist/index.js --version",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github",
    "artifacts",
    "storage",
    "cli",
    "analysis"
  ],
  "author": "Scott Hanselman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanselman/github-artifacts-analyzer.git"
  },
  "homepage": "https://github.com/shanselman/github-artifacts-analyzer#readme",
  "bugs": {
    "url": "https://github.com/shanselman/github-artifacts-analyzer/issues"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "bytes": "^3.1.2",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "dotenv": "^17.2.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
